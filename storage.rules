rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeMember(companyId) { return request.auth != null && firestore.exists(/databases/(default)/documents/companies/$(companyId)/members/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.status == 'active'; }
    match /users/{uid}/{allPaths=**} { allow read, write: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024; }
    match /companies/{companyId}/{allPaths=**} { allow read: if activeMember(companyId); allow write: if activeMember(companyId) && request.resource.size < 20 * 1024 * 1024; }
  }
}
